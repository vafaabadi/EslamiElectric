# Copy to ".env" for local development (never commit .env).
# This file should use your STAGING Supabase project only (same as Vercel Preview).
# Vercel Production uses your PRODUCTION Supabase project — set those in the Vercel dashboard (see ENVIRONMENTS.md).

# --- Core (required) ---
PORT=3000
# Staging secret; use a different value for Vercel Production.
JWT_SECRET=replace_with_long_random_hex_use_openssl_rand_hex_32

# Supabase — STAGING project (local + Vercel Preview). Do not put production project keys here.
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_secret
SUPABASE_ANON_KEY=your_staging_anon_public_key
SUPABASE_JWT_SECRET=your_staging_jwt_signing_secret_from_supabase_settings

# Public URL of the app (no trailing slash). Local dev:
BASE_URL=http://localhost:3000
# Optional alias (server also reads this if set):
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Stripe — TEST keys (sk_test_ / pk_test_) are fine for local, Preview, and Production until you go live ---
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
# Optional; not read by server.js today — for future client-side Stripe.js if you add it.
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
# On Vercel Production only: set to 1 while using sk_test_ there (silences startup warning). Remove when switching to live keys.
# STRIPE_ALLOW_TEST_IN_PRODUCTION=1

# --- Email (Resend) ---
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM=Eslami Electric <orders@your-verified-domain.com>

# --- Telegram (optional): order notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram Login widget (optional) ---
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_AUTH_EMAIL_DOMAIN=
# Comma-separated hostnames allowed for the widget (plus BASE_URL / VERCEL_URL are auto-added on the server)
TELEGRAM_LOGIN_WIDGET_DOMAIN=

# --- Optional tuning ---
# LOGIN_LOCKOUT_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=60
# USD_TO_TOMAN=42000
# LOCAL_GEO_COUNTRY=

# --- Local tooling only (not needed on Vercel) ---
# GitHub PAT for Cursor MCP / local scripts — do not add to Vercel unless you have a CI job that needs it
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Explicit override (optional; usually leave unset — Vercel sets VERCEL_ENV) ---
# APP_ENV=development
