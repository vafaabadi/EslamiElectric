# Copy to ".env" for local development (never commit .env).
# This file should use your STAGING Supabase project only (same as Vercel Preview).
# Vercel Production uses your PRODUCTION Supabase project — set those in the Vercel dashboard (see ENVIRONMENTS.md).

# --- Core (required) ---
PORT=3000
# Staging secret; use a different value for Vercel Production.
JWT_SECRET=replace_with_long_random_hex_use_openssl_rand_hex_32

# Supabase — STAGING project (local + Vercel Preview). Do not put production project keys here.
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_secret
SUPABASE_ANON_KEY=your_staging_anon_public_key
SUPABASE_JWT_SECRET=your_staging_jwt_signing_secret_from_supabase_settings

# Admin access is controlled by public.users.is_admin (boolean). After `015_users_is_admin` migration, set is_admin = true
# in Supabase Dashboard (Table Editor) for trusted operators (same email as shop login / public.users.email).
#
# Optional bypass only: comma-separated emails that may access /api/admin/* without is_admin = true (omit for DB-only).
# ADMIN_ALLOWED_EMAILS=
# Optional override for Supabase Storage bucket used for admin product photo uploads (default: product-images).
# CATALOG_IMAGES_BUCKET=product-images

# Public URL of the app (no trailing slash). Local dev:
BASE_URL=http://localhost:3000
# Canonical site URL aliases (SEO sitemap/canonical/Open Graph — same precedence order as below). First non-empty wins.
# PUBLIC_SITE_URL=https://www.eslamielectric.com
# PUBLIC_BASE_URL=https://www.eslamielectric.com  (alias of PUBLIC_SITE_URL)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Playwright: optional admin user (must have users.is_admin = true on the server under test, unless ADMIN_ALLOWED_EMAILS bypass is set).
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Playwright E2E: point tests at a deployed site (production/staging). No trailing slash. When set, Playwright does not start local server.
# Example: PLAYWRIGHT_BASE_URL=https://eslamielectric.com
# Leave unset to test against http://127.0.0.1:3000 with auto-started server.
# PLAYWRIGHT_BASE_URL=
#
# Playwright: optional real user for `tests/e2e/auth-login.spec.ts` (GitHub Actions: add as repository secrets)
# E2E_TEST_USER_EMAIL=
# E2E_TEST_USER_PASSWORD=

# --- Stripe — TEST keys (sk_test_ / pk_test_) are fine for local, Preview, and Production until you go live ---
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
# Optional; not read by server.js today — for future client-side Stripe.js if you add it.
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
# On Vercel Production only: set to 1 while using sk_test_ there (silences startup warning). Remove when switching to live keys.
# STRIPE_ALLOW_TEST_IN_PRODUCTION=1


# --- Email (Resend) ---
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM=Eslami Electric <orders@your-verified-domain.com>

# --- Telegram (optional): order notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram Login widget (optional) ---
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
# If empty, server uses SUPABASE_URL hostname (e.g. xxxxx.supabase.co) for synthetic tg_*@… emails
TELEGRAM_AUTH_EMAIL_DOMAIN=
# Comma-separated hostnames allowed for the widget (plus BASE_URL / VERCEL_URL are auto-added on the server)
TELEGRAM_LOGIN_WIDGET_DOMAIN=

# --- Optional tuning ---
# Set to 1 on server + PROFILE_DELETE_ACCOUNT_ENABLED=true in public/profile.html to allow self-service account deletion.
# ACCOUNT_DELETION_ENABLED=1
# LOGIN_LOCKOUT_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=60
# USD_TO_TOMAN=42000
# LOCAL_GEO_COUNTRY=

# --- Local tooling only (not needed on Vercel) ---
# GitHub PAT for Cursor MCP / local scripts — do not add to Vercel unless you have a CI job that needs it
# GITHUB_PERSONAL_ACCESS_TOKEN=
#
# Supabase Management API (optional): personal access token from https://supabase.com/dashboard/account/tokens
# Used only by: npm run supabase:auth-hibp  (enables leaked-password / HIBP on projects listed in the script)
# NOT the anon or service_role key — never commit this value.
# SUPABASE_ACCESS_TOKEN=
# Optional override: comma-separated project refs (default: staging + production refs from ENVIRONMENTS.md)
# SUPABASE_HIBP_PROJECT_REFS=your_staging_ref,your_production_ref

# --- Explicit override (optional; usually leave unset — Vercel sets VERCEL_ENV) ---
# APP_ENV=development
