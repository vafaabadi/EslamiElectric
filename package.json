{
  "name": "lighting-products-app",
  "version": "1.0.0",
  "description": "Local web app showcasing electrical lighting products",
  "engines": {
    "node": ">=20.17.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "tailwindcss -i ./src/tailwind-input.css -o ./public/css/tailwind.css --minify",
    "lighthouse": "node scripts/lighthouse-run.mjs",
    "lighthouse:all": "node scripts/lighthouse-run.mjs --all",
    "supabase:auth-hibp": "node scripts/enable-supabase-leaked-password-protection.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:ui": "playwright test -c playwright.config.ts --ui",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "e2e:headed": "node scripts/run-e2e-headed.mjs",
    "test:e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc -p tsconfig.playwright.json --noEmit",
    "test": "node --test test/**/*.test.js"
  },
  "keywords": [
    "lighting",
    "products",
    "express",
    "node"
  ],
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.127",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.68",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.198",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "basic-ftp": "^5.3.0"
  }
}
