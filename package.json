{
  "name": "lighting-products-app",
  "version": "1.0.0",
  "description": "Local web app showcasing electrical lighting products",
  "engines": {
    "node": ">=20.17.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "tailwindcss -i ./src/tailwind-input.css -o ./public/css/tailwind.css --minify",
    "lighthouse": "node scripts/lighthouse-run.mjs",
    "lighthouse:all": "node scripts/lighthouse-run.mjs --all",
    "supabase:auth-hibp": "node scripts/enable-supabase-leaked-password-protection.mjs"
  },
  "keywords": [
    "lighting",
    "products",
    "express",
    "node"
  ],
  "license": "ISC",
  "dependencies": {
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.9.3",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2",
    "tailwindcss": "^3.4.17"
  }
}
